# This tutorial does not require an API key.
# Copy this file to .env, then change local settings if desired.

# The first notebook run downloads the CC BY 4.0 UCI Online Retail CSV here.
UCI_RETAIL_CACHE=data/cache/online_retail.csv

# Set to a positive integer to keep only the most active N customers for a
# faster classroom run. Leave blank to use every identified customer.
TUTORIAL_CUSTOMER_LIMIT=

# Set to 1 to execute the optional local Chronon Spark backfill in notebook §8.
# The first run downloads the pinned 25 MB Chronon assembly JAR from Maven Central.
RUN_CHRONON_SPARK=0
