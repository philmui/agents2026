# Copy to .env. Never commit credentials.
# Both switches default to 0; notebooks do not download models or call APIs.
MM_RUN_MODELS=0
MM_RUN_LIVE=0

# Provider-qualified vision model. gpt-5.6-sol may be a gateway alias;
# verify that your endpoint provides this name and supports image inputs.
VLM_MODEL=openai/gpt-5.6-sol
VLM_API_BASE=
VLM_API_KEY=

# Embeddings are a DIFFERENT endpoint/model from the vision-language model.
EMBED_MODEL=openai/text-embedding-3-small
EMBED_API_BASE=
EMBED_API_KEY=
