# =============================================================================
# .gitignore — capstone project root (Python backend + React/Next.js frontend)
# =============================================================================
# This repo holds two apps: a Python (uv) backend in backend/ and a Next.js
# frontend in app/. The rules below are project-wide; app/ and backend/ each
# also carry a local .gitignore for anything specific to them.

# -----------------------------------------------------------------------------
# Secrets — NEVER commit. The one shared key lives at topics/voice_agents/.env.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env*.example
!.env.local.example

# =============================================================================
# Python (backend/ and the optional root .venv)
# =============================================================================
# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Byte-compiled / optimized / C extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build artifacts
build/
dist/
sdist/
wheels/
*.egg
*.egg-info/
.eggs/
.installed.cfg
MANIFEST

# Test / coverage / type-check / lint caches
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter / IPython
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Reproducibility: DO commit the BACKEND lockfile (the real dependencies live in
# backend/). The pinned versions are the whole point of this tutorial (a classmate
# must get a byte-for-byte identical install), so un-ignore just that one. The
# module-root pyproject has no dependencies, so its lockfile stays ignored.
!backend/uv.lock

# =============================================================================
# Node / React / Next.js (app/)
# =============================================================================
# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
build/
next-env.d.ts.timestamp

# Production bundles / misc build
dist/

# Debug / package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# TypeScript incremental build info
*.tsbuildinfo

# Testing / coverage (JS)
coverage/
.nyc_output/

# Caches / tooling
.eslintcache
.turbo/
.parcel-cache/

# Deployment
.vercel/

# =============================================================================
# Editors, OS, and misc
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json
