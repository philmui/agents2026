# =============================================================================
# app/.gitignore — the Next.js / React frontend
# =============================================================================
# The project root also carries a .gitignore; these rules are the app-local
# additions (and duplicates are harmless).

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
build/
dist/
next-env.d.ts.timestamp

# TypeScript incremental build info
*.tsbuildinfo

# Testing / coverage
coverage/
.nyc_output/

# Caches / tooling
.eslintcache
.turbo/
.parcel-cache/

# Deployment
.vercel/

# Debug / package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Local env files (never commit secrets). The shared key lives in
# ../../.env (topics/voice_agents/.env); a Next-local override would go here.
.env
.env.*
!.env.example
!.env*.example
!.env.local.example

# OS cruft
.DS_Store
._*
Thumbs.db
