# ---------------------------------------------------------------------------
# Next.js app environment - copy to ".env.local" and (optionally) edit.
#
#   cp .env.local.example .env.local
#
# Next.js automatically loads .env.local for `npm run dev` and `npm run build`.
# Your real OPENAI_API_KEY lives ONLY in the Python backend's environment (loaded
# from the shared topics/voice_agents/.env via python-dotenv), never here and
# never in the browser. The values below are the backend's ADDRESS (not secret)
# and, optionally, a light shared caller token. See backend/README.md.
# ---------------------------------------------------------------------------

# Where the browser finds the FastAPI backend (backend/src/main.py). Used for both
# the token fetch (GET {BACKEND_URL}/token) and live translation (WS {BACKEND_URL}
# -> ws://.../translate). Default local dev value is the line below; leave it as-is
# unless you run the backend on another host/port.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# OPTIONAL: use THIS Next.js app's own built-in token route instead of the FastAPI
# backend's /token (e.g. if you deploy the UI by itself). If you set this, also set
# OPENAI_API_KEY below so the built-in route (app/api/token/route.ts) can mint
# tokens. Leave it UNSET to use the FastAPI backend (the default full-app setup).
# NOTE: Translate mode ALWAYS needs the FastAPI backend's WS /translate, so run the
# backend regardless of this setting.
#   NEXT_PUBLIC_TOKEN_ENDPOINT=/api/token
NEXT_PUBLIC_TOKEN_ENDPOINT=

# OPTIONAL (only if you set NEXT_PUBLIC_TOKEN_ENDPOINT=/api/token above): the real
# key for the built-in Next.js token route. It stays SERVER-ONLY (no NEXT_PUBLIC_
# prefix) and is never shipped to the browser. Normally you leave this blank and
# let the Python backend hold the key instead.
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL: a light shared caller token for a DEPLOYED demo. Set this to the SAME
# value you set as CAPSTONE_API_TOKEN on the backend, and the app will send it on
# every backend call so the backend accepts them. Leave BOTH blank for local work.
# NOTE: a NEXT_PUBLIC_ value is visible in the browser bundle, so this deters
# casual abuse of a public URL; it is not real per-user login.
NEXT_PUBLIC_CAPSTONE_API_TOKEN=
