# ---------------------------------------------------------------------------
# Frontend environment (module 07).  Copy this to ".env.local":
#     cp .env.local.example .env.local
#
# IMPORTANT: the browser NEVER gets your real OpenAI key. The only value the
# frontend needs is the URL of the module-06 backend, which mints a short-lived
# ephemeral "ek_..." token for us. Anything prefixed with NEXT_PUBLIC_ is baked
# into the browser bundle, so only put NON-secret values here.
#
# This mirrors NEXT_PUBLIC_TOKEN_ENDPOINT in the shared topics/voice_agents/.env,
# but Next.js reads env vars from THIS app folder, so we keep a local copy.
# ---------------------------------------------------------------------------

# Where the module-06 FastAPI backend exposes its /token route.
NEXT_PUBLIC_TOKEN_ENDPOINT=http://localhost:8000/token
