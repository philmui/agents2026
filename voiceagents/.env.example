# ---------------------------------------------------------------------------
# Voice Agents minicourse: SHARED secrets file.
#
# Copy this file to ".env" (same folder) and paste your real key:
#     cp .env.example .env
#
# This ONE file at topics/voice_agents/.env is shared by every module. Each
# Python module calls  load_dotenv(find_dotenv())  which walks UP the folder
# tree from the module until it finds this .env, so you only set the key once.
#
# NEVER commit .env. It is already in every module's .gitignore.
# The Next.js frontend must NOT read this key in the browser: only the Python
# backend (module 06) reads OPENAI_API_KEY, and it hands the browser a short-
# lived ephemeral "ek_..." token instead. See _shared/API_FACTS.md.
# ---------------------------------------------------------------------------

# Your OpenAI API key (must be on a paid tier: the free tier cannot use Realtime).
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: a stable, hashed per-user id sent as OpenAI-Safety-Identifier.
# Leave blank for the course; it is only for production abuse tracking.
OPENAI_SAFETY_IDENTIFIER=

# ---------------------------------------------------------------------------
# Langfuse telemetry (used by module 09_capstone_openai ONLY; optional).
#
# Module 09 traces every Assist web search and Translate session to Langfuse so
# you can watch the agent's steps on a dashboard. Leave these BLANK and module 09
# still runs perfectly, just without tracing (GET /health shows "telemetry":false).
#
# To turn tracing on: make a free project at https://cloud.langfuse.com, open
# Settings -> API Keys, and paste the pk-lf-/sk-lf- pair below. Pick the base URL
# for your region (EU is the default). All other modules ignore these variables.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com  |  US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: which environment label to stamp on traces (default: development).
LANGFUSE_TRACING_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Access controls for the module 09 backend (all OPTIONAL; leave blank locally).
#
# The module 09 backend's paid routes (/token, /web-search, /translate) spend
# real money. On localhost you leave these blank and the routes are open. For a
# DEPLOYED demo, set a shared caller token so it is not an open wallet, and (if
# needed) raise the per-caller rate limit. See 09_capstone_openai/backend/README.
# ---------------------------------------------------------------------------
# If set, every paid backend route requires "Authorization: Bearer <this>" (the
# /translate WebSocket reads it from its first message). The frontend sends it
# when you ALSO set NEXT_PUBLIC_CAPSTONE_API_TOKEN to the same value.
CAPSTONE_API_TOKEN=
# Max paid requests per caller IP per minute (default 60 when blank).
CAPSTONE_RATE_LIMIT_PER_MIN=
# Comma-separated exact origins allowed to open the /translate WebSocket, in
# addition to localhost (e.g. https://your-app.example.com).
CAPSTONE_ALLOWED_ORIGINS=

# Where the Next.js frontend (modules 07-08) finds the Python backend (module 06).
# Used by the browser to fetch an ephemeral token. Default local dev value:
NEXT_PUBLIC_TOKEN_ENDPOINT=http://localhost:8000/token
