#
# TypeSafe API Key and OpenAI API Key are required to run the application.
# Please obtain them from the respective websites and replace the placeholders below.
#
TYPESAFE_API_KEY=<get from https://app.typesafe.dev>
OPENAI_API_KEY=<get from https://platform.openai.com/account/api-keys>
OPENAI_ORG_ID=<get from https://platform.openai.com/account/org-settings>
